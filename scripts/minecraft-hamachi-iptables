SERVER_IP=25.0.0.1
SERVER_PORT=25565

sysctl -w net.ipv4.ip_forward=1
iptables -t nat -A PREROUTING -i eth0 -p tcp --dport $SERVER_PORT -j DNAT --to-destination $SERVER_IP:$SERVER_PORT
iptables -A FORWARD -p tcp -d $SERVER_IP --dport $SERVER_PORT -j ACCEPT
iptables -A FORWARD -p tcp -s $SERVER_IP --sport $SERVER_PORT -j ACCEPT
iptables -t nat -A POSTROUTING -o ham0 -j MASQUERADE
