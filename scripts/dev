#!/usr/bin/env bash
mapfile -t NAMES < <(podman ps --format "{{.Names}}")
NAME="${NAMES[0]}"
if [ -z "$NAME" ]; then
    NAME=$1
    if [ -z "$NAME" ]; then
        echo "Usage: $0 <name>"
        echo "Error: No argument provided."
        exit 1
    fi
fi

podman network exists dev-net || podman network create dev-net 
podman container exists "$NAME"
EXISTS=$?
RUNNING=$(podman ps --filter "name=$NAME" --filter "status=running" -q)

xhost +local:amg

if [ "$EXISTS" != "0" ]; then
    if [ -z "$(podman images -q devenv)" ]; then
        echo "Image not found, building now..."
        podman build -t devenv -f $HOME/Scripts/Containerfile.dev $HOME/.podman
    fi

    VOLUMES=""
    ARGS=""

    # Mount x11 socket 
    # TODO Mount wayland socket instead using security context v1
    VOLUMES="$VOLUMES -v /tmp/.X11-unix:/tmp/.X11-unix"

    # Mount pulseaudio socket
    # TODO Mount pipewire instead 
    # Use pw-container -P '{"pipewire.sec.engine":"podman.devcontainer"}'
    VOLUMES="$VOLUMES -v /run/user/$UID/pulse/native:/run/user/$UID/pulse/native"

    # Check nvidia gpu presence
    if command -v nvidia-smi &> /dev/null; then
        echo "Using nvidia gpu"
        ARGS="$ARGS --gpus all"
    fi

    podman create -it \
        $VOLUMES \
        $ARGS \
        -P \
        --network dev-net \
        -e DISPLAY=$DISPLAY \
        -e PULSE_SERVER=unix:/run/user/$UID/pulse/native \
        --device /dev/dri \
        --name "$NAME" devenv bash

    podman start -ai "$NAME"
    exit
fi

if [ -z "$RUNNING" ]; then
    echo Starting existing container...
    podman start -ai "$NAME"
    exit
fi

echo Attaching to running container...
podman exec -it "$NAME" bash
