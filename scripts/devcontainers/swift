# Swift 
RUN apt-get install -y gpg libicu-dev libcurl4-openssl-dev libedit-dev \
 libsqlite3-dev libncurses-dev libpython3-dev libxml2-dev pkg-config uuid-dev \
 libstdc++-12-dev && \
su - amgdev -c "bash -c '\
curl -O https://download.swift.org/swiftly/linux/swiftly-x86_64.tar.gz && \
tar zxf swiftly-$(uname -m).tar.gz && \
./swiftly init --quiet-shell-followup -y --platform debian12 && \
. \$HOME/.local/share/swiftly/env.sh && \
hash -r && \
mkdir -p \$HOME/.config/nvim-code/lua/custom && \
echo \"local M = {}\\n\
\\n\
function M.setup_lsp(capabilities)\\n\
  vim.lsp.config(\\\"sourcekit\\\", { capabilities = capabilities })\\n\
  vim.lsp.enable(\\\"sourcekit\\\")\\n\
end\\n\
\\n\
function M.get_formatters_by_ft()\\n\
  return {}\\n\
end\\n\
\\n\
return M\" > \$HOME/.config/nvim-code/lua/custom/swift.lua\
'"

